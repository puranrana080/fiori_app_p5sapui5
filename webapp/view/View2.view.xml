<mvc:View controllerName="com.demo.p5sapui5.controller.View2"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:f="sap.ui.layout.form"
    xmlns="sap.m">
    <Page id="page2" title="Employee Details" showNavButton="true" navButtonPress="onBackToView1">
    <content>
    <!-- <Button id="btn-2" text="Go to Page 1" press="backbutton" ></Button> -->
    <Text id="twotext" text="Welcome to SAPUI5" textAlign="Center" width="100%" class="sapMH2FontSize" />

    <Panel id="idPanel">
    <headerToolbar>
    <Toolbar >
    <Title text="Employee Details"></Title>
    <ToolbarSpacer ></ToolbarSpacer>
    <Button id="idBtnEdit" icon="sap-icon://edit" type="Emphasized" visible="false" press="onPressEdit" ></Button>
    <Button id="idBtnDisplay" icon="sap-icon://display" type="Emphasized" visible="false"></Button>
    <Button id="idBtnSave" icon="sap-icon://save" type="Accept" visible="false" press="onPressSave"></Button>
    <Button id="idBtnCancel" icon="sap-icon://reset" type="Reject" visible="false" press="onPressCancel" ></Button>
     <Button id="idBtnDelete" icon="sap-icon://delete" type="Reject" visible="false"></Button>
    
    </Toolbar>
    </headerToolbar>
    
    </Panel>


     

    
    </content>
    </Page>
</mvc:View>