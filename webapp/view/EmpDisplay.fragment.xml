<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
     xmlns:f="sap.ui.layout.form"
>
<VBox >
<HBox >
<Avatar active="true" press="onPressPhoto"  src ="/sap/opu/odata/sap/ZP5_EMP_SRV/PhotoSet('{Empid}')/$value" displaySize="L" ></Avatar>
<VBox class="sapUiMediumMargin">
<Text text="{Name}"></Text>
<Text text="{Designation}"></Text>
</VBox>
</HBox>
     <f:SimpleForm id="idSF"
             title="Employee Details"  editable="true" layout="ResponsiveGridLayout" labelSpanL="4"
                labelSpanM="4"
                emptySpanL="3"
                emptySpanM="3"
                columnsL="3"
                columnsM="2"
            >
                <f:content>
                    <Label text="Employee ID"  />
                    <Text  text="{Empid}" ></Text>
                     <Label text="Name"  />
                    <Text  text="{Name}"  ></Text>
                     <Label text="Designation"  />
                    <Text  text="{Designation}"  ></Text>
                     <Label text="Skill"  />
                    <Text  text="{Skill}"  ></Text>
                     <Label text="Email"  />
                    <Text  text="{Email}"  ></Text>
                    <Label text="Phone No."  />
                    <Text  text="{Phone}"  ></Text>
                    <Label text="Salary"  />
                    <Text  text="{Salary}"  ></Text>
                    <Label text="Date of Joining"  />
                    <Text  text="{Doj}"  ></Text>
                    <Label text="Status"  />
                    <Text  text="{Status}" ></Text>
                    <Label text="Rating"  />
                    <RatingIndicator  value="{Rating}" enabled="false" ></RatingIndicator>       
            </f:content>
            </f:SimpleForm>

            <ScrollContainer vertical="true" horizontal="true" >
            <Table items="{toProjects}" headerText="Project Information">

            <columns>
            <Column width="10rem">
            <Text text="Employee Id"></Text>
            </Column>
             <Column width="10rem">
            <Text text="Project Code"></Text>
            </Column>
             <Column width="10rem">
            <Text text="Client Name"></Text>
            </Column>
             <Column width="10rem">
            <Text text="Project Name"></Text>
            </Column>
              <Column width="25rem">
            <Text text="Project Description"></Text>
            </Column>
             <Column width="10rem">
            <Text text="Team Count"></Text>
            </Column>
            </columns>
            <items>
            <ColumnListItem >
            
            <cells>
            <Text text="{Empid}"></Text>
            <Text text="{Prjcode}"></Text>
            <Text text="{Clientname}"></Text>
            <Text text="{Prjname}"></Text>
            <Text text="{Prjdesc}"></Text>
            <Text text="{Teamsize}"></Text>
            </cells>
            </ColumnListItem>
            
            
            </items>
            </Table>
             </ScrollContainer>

          <Table items="{toResumes}" headerText="Employee CV">

            <columns>
            <Column >
            <Text text="Employee Id"></Text>
            </Column>
             <Column >
            <Text text="Resume"></Text>
            </Column>
              <Column >
            <Text text="Download"></Text>
            </Column>
            </columns>
            <items>
            <ColumnListItem >
            
            <cells>
            <Text text="{Empid}"></Text>
            <Text text="{Filename}"></Text>
            <Button icon="sap-icon://download" type="Reject"press="onPressDownload" ></Button>
          
            </cells>
            </ColumnListItem>
            
            
            </items>
            </Table>

            </VBox>
</core:FragmentDefinition>
