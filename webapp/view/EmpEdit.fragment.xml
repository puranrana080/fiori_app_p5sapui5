<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form"
    xmlns:u="sap.ui.unified"
>
<VBox >
    <f:SimpleForm id="idSF1"
             title="Employee Details"  editable="true" layout="ResponsiveGridLayout" labelSpanL="4"
                labelSpanM="4"
                emptySpanL="3"
                emptySpanM="3"
                columnsL="3"
                columnsM="2"
            >
                <f:content>
                    <Label text="Employee ID"  />
                    <Input id="idEmpId1" value="{Empid}" ></Input>
                     <Label text="Name"  />
                    <Input id="idName1" value="{Name}"  ></Input>
                     <Label text="Designation"  />
                    <Input id="idDesig1" value="{Designation}"  ></Input>
                     <Label text="Skill"  />
                    <Input id="idSkill1" value="{Skill}"  ></Input>
                     <Label text="Email"  />
                    <Input id="idEmail1" value="{Email}"  ></Input>
                    <Label text="Phone No."  />
                    <Input id="idPhone1" value="{Phone}"  ></Input>
                    <Label text="Salary"  />
                    <Input id="idSalary1" value="{Salary}" ></Input>
                    <Label text="Date of Joining"  />
                    <DatePicker id="idDoj1" dateValue="{Doj}"  ></DatePicker>
                    <Label text="Status"  />
                    <Input id="idStatus1" value="{Status}"  ></Input>
                    <Label text="Rating"  />
                    <RatingIndicator id="idRating1" value="{Rating}"  ></RatingIndicator>       
            </f:content>
            </f:SimpleForm>

             <Table items="{editPrjModel>/results}">
        <headerToolbar>
        <Toolbar >
        <Title text="Edit Project"></Title>
        <ToolbarSpacer></ToolbarSpacer>
        <Button icon="sap-icon://add" type="Emphasized" press="onPressAddRowForEdit"></Button>
        </Toolbar>
        </headerToolbar>
       <columns>
       <Column >
       <Text text="Employee Id"></Text>
       </Column>
         <Column >
       <Text text="Project Code"></Text>
       </Column>
         <Column >
       <Text text="Client Name"></Text>
       </Column>
         <Column >
       <Text text="Project Name"></Text>
       </Column>
         <Column >
       <Text text="Project Description"></Text>
       </Column>
           <Column >
       <Text text="Count"></Text>
       </Column>
       <Column >
       <Text text="Delete"></Text>
       </Column>
       
       </columns>
       <items>
       
       <ColumnListItem >
       <cells>
       <Input value="{editPrjModel>Empid}"></Input>
       <Input value="{editPrjModel>Prjcode}"></Input>
       <Input value="{editPrjModel>Prjname}"></Input>
       <Input value="{editPrjModel>Clientname}"></Input>
       <Input value="{editPrjModel>Prjdesc}"></Input>
         <Input value="{editPrjModel>Teamsize}"></Input>
         <Button icon="sap-icon://delete" type="Reject" press="onPressDeleteRowForEdit"></Button>
       </cells>
       
       </ColumnListItem>
       </items>
        </Table>
          <f:SimpleForm
            editable="true"
            title="Edit the profile Picture"
             layout="ResponsiveGridLayout"
            labelSpanL="5"
            labelSpanM="5"
            emptySpanL="3"
            emptySpanM="3"
        >
            <f:content>
            <Label text="Select the photo"></Label>
            <u:FileUploader id="idFileUploader" uploadUrl="/sap/opu/odata/sap/ZP5_EMP_SRV/PhotoSet" sendXHR="true" 
            change="onChangeFile" uploadComplete="onPhotoUploadComplete"
            useMultipart="false" width="200px"></u:FileUploader>
            <Label ></Label>
            <Button icon="sap-icon://upload" text="Upload" width="150px" type="Emphasized" press="onUploadPhoto"></Button>
            </f:content>
        </f:SimpleForm>
        </VBox>
</core:FragmentDefinition>