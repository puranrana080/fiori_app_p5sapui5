<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form"
>
    <f:SimpleForm 
             title="Employee Details"  editable="true" layout="ResponsiveGridLayout" labelSpanL="4"
                labelSpanM="4"
                emptySpanL="3"
                emptySpanM="3"
                columnsL="3"
                columnsM="2"
            >
                <f:content>
                    <Label text="Employee ID"  />
                    <Input id="idEmpId2" required="true" ></Input>
                     <Label text="Name"  />
                    <Input id="idName2" required="true"></Input>
                     <Label text="Designation"  />
                    <Input id="idDesig2"  required="true" ></Input>
                     <Label text="Skill"  />
                    <Input id="idSkill2" required="true"  ></Input>
                     <Label text="Email"  />
                    <Input id="idEmail2" required="true"  ></Input>
                    <Label text="Phone No."  />
                    <Input id="idPhone2" required="true"  ></Input>
                    <Label text="Salary"  />
                    <Input id="idSalary2" required="true" ></Input>
                    <Label text="Date of Joining"  />
                    <DatePicker id="idDoj2" required="true" ></DatePicker>
                    <Label text="Status"  />
                    <Input id="idStatus2" required="true" ></Input>
                    <Label text="Rating"  />
                    <RatingIndicator id="idRating2"  required="true" ></RatingIndicator>       
            </f:content>
            </f:SimpleForm>
</core:FragmentDefinition>